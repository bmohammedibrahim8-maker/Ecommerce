from datetime import datetime

arriveAlice = input("Alice arrival date: ")
leaveAlice = input("Alice leaving date: ")

arriveBob = input("Bob arrival date: ")
leaveBob = input("Bob leaving date: ")

a1 = datetime.strptime(arriveAlice, "%m-%d")
a2 = datetime.strptime(leaveAlice, "%m-%d")

b1 = datetime.strptime(arriveBob, "%m-%d")
b2 = datetime.strptime(leaveBob, "%m-%d")

start = max(a1, b1)
end = min(a2, b2)

if start <= end:
    days = (end - start).days + 1
else:
    days = 0

print("Common days:", days)